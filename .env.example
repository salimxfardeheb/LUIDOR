# Copier ce fichier en `.env` puis renseigner les valeurs.
# `.env` est ignoré par git : aucun secret ne doit être committé.

# --- Base de données -------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/liudor?sslmode=require"

# --- Mode démo (voir lib/demo.ts) ------------------------------------------
# À "1", seul le site public reste accessible : les espaces client, propriétaire
# et administration sont renvoyés vers l'accueil et leurs liens disparaissent de
# l'en-tête et du pied de page. Sert à présenter une partie du site.
# `npm run dev:demo` active le mode sans toucher à ce fichier.
NEXT_PUBLIC_DEMO_MODE="0"

# --- Auth.js ---------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Générer une valeur : openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Cloudinary (photos des salles, voir lib/storage.ts) -------------------
# Une seule variable suffit : elle se trouve dans le tableau de bord Cloudinary
# (Settings → API Keys), sous la forme cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""

# Variante équivalente, si vous préférez séparer les valeurs. Ignorée dès que
# CLOUDINARY_URL est renseignée.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
