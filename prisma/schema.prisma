generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  OWNER
  ADMIN
}

enum RoomStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum AvailabilityStatus {
  AVAILABLE
  BLOCKED
}

enum BookingStatus {
  EN_ATTENTE
  EN_COURS_VERIFICATION
  CONFIRMEE
  ANNULEE
  CLOTUREE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  role         UserRole  @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms    Room[]    @relation("RoomOwner")
  bookings Booking[] @relation("BookingClient")
  payments Payment[] @relation("PaymentRecorder")
  reviews  Review[]  @relation("ReviewClient")

  @@map("users")
}

model Category {
  id       String @id @default(cuid())
  name     String @unique
  iconSlug String

  rooms Room[]

  @@map("categories")
}

model Room {
  id           String     @id @default(cuid())
  ownerId      String
  categoryId   String
  name         String
  description  String     @db.Text
  city         String
  address      String
  latitude     Float?
  longitude    Float?
  capacityMin  Int
  capacityMax  Int
  basePrice    Decimal    @db.Decimal(10, 2)
  status       RoomStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner      User         @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  category   Category     @relation(fields: [categoryId], references: [id])
  photos     Photo[]
  availabilities Availability[]
  bookings   Booking[]
  reviews    Review[]
  equipments RoomEquipment[]
  services   RoomService[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([city])
  @@map("rooms")
}

model Photo {
  id       String @id @default(cuid())
  roomId   String
  url      String
  position Int    @default(0)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("photos")
}

model Availability {
  id     String             @id @default(cuid())
  roomId String
  date   DateTime           @db.Date
  status AvailabilityStatus @default(AVAILABLE)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@index([date])
  @@map("availabilities")
}

model Equipment {
  id   String @id @default(cuid())
  name String @unique

  rooms RoomEquipment[]

  @@map("equipments")
}

model RoomEquipment {
  roomId      String
  equipmentId String

  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([roomId, equipmentId])
  @@map("room_equipments")
}

model Service {
  id    String  @id @default(cuid())
  name  String
  price Decimal @db.Decimal(10, 2)

  rooms RoomService[]

  @@map("services")
}

model RoomService {
  roomId    String
  serviceId String

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([roomId, serviceId])
  @@map("room_services")
}

model Booking {
  id         String        @id @default(cuid())
  clientId   String
  roomId     String
  eventType  String
  eventDate  DateTime      @db.Date
  guestsCount Int
  contactPhone String
  contactEmail  String
  status     BookingStatus @default(EN_ATTENTE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  client   User       @relation("BookingClient", fields: [clientId], references: [id], onDelete: Cascade)
  room     Room       @relation(fields: [roomId], references: [id], onDelete: Restrict)
  payment  Payment?

  @@index([clientId])
  @@index([roomId])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id         String        @id @default(cuid())
  bookingId  String        @unique
  amount     Decimal       @db.Decimal(10, 2)
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  recordedBy String?
  createdAt  DateTime      @default(now())

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recordedByUser User? @relation("PaymentRecorder", fields: [recordedBy], references: [id])

  @@index([status])
  @@map("payments")
}

model Review {
  id       String   @id @default(cuid())
  roomId   String
  clientId String
  rating   Int
  comment  String   @db.Text
  createdAt DateTime @default(now())

  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  client User @relation("ReviewClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([roomId, clientId])
  @@index([clientId])
  @@map("reviews")
}

model BlogPost {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  content      String   @db.Text
  coverImageUrl String?
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("blog_posts")
}