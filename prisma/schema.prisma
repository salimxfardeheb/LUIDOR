generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  OWNER
  ADMIN
}

enum RoomStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum AvailabilityStatus {
  AVAILABLE
  BLOCKED
}

enum BookingStatus {
  EN_ATTENTE
  EN_COURS_VERIFICATION
  CONFIRMEE
  ANNULEE
  CLOTUREE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  /// Null pour un compte créé par un provider externe (OAuth) : seul le
  /// Credentials provider s'appuie sur ce hash.
  passwordHash String?
  fullName     String
  phone        String?
  avatarUrl    String?
  role         UserRole  @default(CLIENT)
  emailVerified DateTime?
  /// Langues parlées, affichées sur la carte propriétaire d'une fiche salle.
  languages    String[]  @default([])
  /// Délai de réponse moyen en heures. Saisi par l'équipe tant que la
  /// messagerie interne n'existe pas pour le calculer.
  responseTimeHours Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  rooms    Room[]    @relation("RoomOwner")
  bookings Booking[] @relation("BookingClient")
  payments Payment[] @relation("PaymentRecorder")
  reviews  Review[]  @relation("ReviewClient")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Tables requises par l'adapter Prisma d'Auth.js.
// Inutilisées tant que seul le Credentials provider (session JWT) est actif,
// mais nécessaires pour brancher un provider OAuth sans migration.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id       String @id @default(cuid())
  name     String @unique
  iconSlug String

  rooms Room[]

  @@map("categories")
}

model Room {
  id           String     @id @default(cuid())
  ownerId      String
  categoryId   String
  name         String
  description  String     @db.Text
  city         String
  /// Quartier, affiché dans le fil d'Ariane de la fiche salle.
  district     String?
  address      String
  latitude     Float?
  longitude    Float?
  capacityMin  Int
  capacityMax  Int
  basePrice    Decimal    @db.Decimal(10, 2)
  status       RoomStatus @default(PENDING)

  // --- Caractéristiques affichées sur la fiche salle -----------------------
  // Toutes facultatives : une salle publiée avant l'ajout de ces champs reste
  // valide, et la fiche masque simplement les lignes non renseignées.

  /// Superficie en m².
  surfaceM2    Int?
  /// Nombre d'espaces distincts (grande salle, mezzanine, jardin…).
  spacesCount  Int?
  hasParking   Boolean    @default(false)
  hasAccommodation Boolean @default(false)
  /// Renseigné par l'équipe LIUDOR après vérification : sert de badge « vérifié ».
  verifiedAt   DateTime?
  /// Visite vidéo, mise en avant par une vignette « play » dans la galerie.
  videoUrl     String?

  // --- Informations pratiques ---------------------------------------------

  /// Plage horaire d'utilisation, ex. « 08:00 – 02:00 ».
  openingHours String?
  /// Règles de sonorisation, ex. « Sonorisation autorisée jusqu'à 2h ».
  musicPolicy  String?
  /// Libellé court de la politique d'annulation, ex. « Flexible ».
  cancellationPolicy String?
  /// Conditions complètes, affichées dans la modale ouverte depuis la fiche.
  cancellationTerms  String? @db.Text
  /// Caution demandée à la réservation.
  depositAmount Decimal?  @db.Decimal(10, 2)
  cleaningFee   Decimal?  @db.Decimal(10, 2)
  petsAllowed   Boolean   @default(false)
  wheelchairAccess Boolean @default(false)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner      User         @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  category   Category     @relation(fields: [categoryId], references: [id])
  photos     Photo[]
  availabilities Availability[]
  bookings   Booking[]
  reviews    Review[]
  equipments RoomEquipment[]
  services   RoomService[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([city])
  @@map("rooms")
}

model Photo {
  id       String @id @default(cuid())
  roomId   String
  url      String
  position Int    @default(0)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("photos")
}

model Availability {
  id     String             @id @default(cuid())
  roomId String
  date   DateTime           @db.Date
  status AvailabilityStatus @default(AVAILABLE)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@index([date])
  @@map("availabilities")
}

model Equipment {
  id   String @id @default(cuid())
  name String @unique

  rooms RoomEquipment[]

  @@map("equipments")
}

model RoomEquipment {
  roomId      String
  equipmentId String

  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([roomId, equipmentId])
  @@map("room_equipments")
}

model Service {
  id    String  @id @default(cuid())
  name  String
  price Decimal @db.Decimal(10, 2)

  rooms RoomService[]

  @@map("services")
}

model RoomService {
  roomId    String
  serviceId String

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([roomId, serviceId])
  @@map("room_services")
}

model Booking {
  id         String        @id @default(cuid())
  clientId   String
  roomId     String
  eventType  String
  eventDate  DateTime      @db.Date
  guestsCount Int
  contactPhone String
  contactEmail  String
  status     BookingStatus @default(EN_ATTENTE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  client   User       @relation("BookingClient", fields: [clientId], references: [id], onDelete: Cascade)
  room     Room       @relation(fields: [roomId], references: [id], onDelete: Restrict)
  payment  Payment?

  @@index([clientId])
  @@index([roomId])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id         String        @id @default(cuid())
  bookingId  String        @unique
  amount     Decimal       @db.Decimal(10, 2)
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  recordedBy String?
  createdAt  DateTime      @default(now())

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recordedByUser User? @relation("PaymentRecorder", fields: [recordedBy], references: [id])

  @@index([status])
  @@map("payments")
}

model Review {
  id       String   @id @default(cuid())
  roomId   String
  clientId String
  rating   Int
  comment  String   @db.Text
  /// Photo jointe à l'avis, affichée en vignette sous le commentaire.
  photoUrl String?
  createdAt DateTime @default(now())

  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  client User @relation("ReviewClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([roomId, clientId])
  @@index([clientId])
  @@map("reviews")
}

model BlogPost {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  content      String   @db.Text
  coverImageUrl String?
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("blog_posts")
}

/// Message envoyé depuis le formulaire /contact. L'équipe LIUDOR le lit dans
/// l'administration (/admin/messages) ; un exemplaire part aussi par email.
model ContactMessage {
  id        String    @id @default(cuid())
  fullName  String
  email     String
  subject   String
  /// Contenu du message, en clair.
  message   String    @db.Text
  /// Renseigné quand un administrateur marque le message comme traité.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt])
  @@index([createdAt])
  @@map("contact_messages")
}