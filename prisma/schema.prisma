generator client {
  provider = "prisma-client-js"
}

/// `url` est **obligatoire** ici en Prisma 6 : sans lui, `prisma validate`
/// échoue en P1012 et migrate comme generate cessent de fonctionner.
///
/// Un éditeur peut signaler « The datasource property `url` is no longer
/// supported in schema files » : cet avertissement vient d'un outillage
/// Prisma 7 (extension VS Code auto-mise à jour), pas du projet, qui est en
/// 6.19. Ne pas retirer la ligne pour le faire taire — aligner l'extension sur
/// la version du projet.
///
/// Le jour de la montée en Prisma 7, `url` se déplacera dans `prisma.config.ts`
/// (clé `datasource`) et le client de `lib/prisma.ts` devra recevoir un driver
/// adapter (`@prisma/adapter-pg`).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  OWNER
  ADMIN
}

enum RoomStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum AvailabilityStatus {
  AVAILABLE
  BLOCKED
}

enum BookingStatus {
  EN_ATTENTE
  EN_COURS_VERIFICATION
  CONFIRMEE
  ANNULEE
  CLOTUREE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  /// Null pour un compte créé par un provider externe (OAuth) : seul le
  /// Credentials provider s'appuie sur ce hash.
  passwordHash      String?
  fullName          String
  phone             String?
  avatarUrl         String?
  /// Identifiant Cloudinary de l'avatar, requis pour supprimer l'ancien fichier
  /// lors d'un remplacement. Null pour un avatar qui ne vient pas de Cloudinary.
  avatarPublicId    String?
  role              UserRole  @default(CLIENT)
  emailVerified     DateTime?
  /// Langues parlées, affichées sur la carte propriétaire d'une fiche salle.
  languages         String[]  @default([])
  /// Délai de réponse moyen en heures. Saisi par l'équipe tant que la
  /// messagerie interne n'existe pas pour le calculer.
  responseTimeHours Int?
  /// Date de suspension du compte par un administrateur, `null` si le compte
  /// est actif. La connexion est refusée tant que ce champ est renseigné.
  suspendedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  rooms       Room[]           @relation("RoomOwner")
  bookings    Booking[]        @relation("BookingClient")
  payments    Payment[]        @relation("PaymentRecorder")
  /// Reversements en espèces remis aux propriétaires par cet administrateur.
  payouts     Payment[]        @relation("PaymentPayoutRecorder")
  reviews     Review[]         @relation("ReviewClient")
  favorites   Favorite[]
  /// Décisions de modération prises par cet administrateur.
  moderations RoomModeration[] @relation("RoomModerator")
  /// Actions sensibles tracées au journal d'audit.
  auditLogs   AuditLog[]       @relation("AuditAuthor")

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Tables requises par l'adapter Prisma d'Auth.js.
// Inutilisées tant que seul le Credentials provider (session JWT) est actif,
// mais nécessaires pour brancher un provider OAuth sans migration.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id       String @id @default(cuid())
  name     String @unique
  iconSlug String

  /// Salles dont c'est la catégorie principale (`Room.categoryId`).
  rooms     Room[]
  /// Toutes les salles rattachées à cette catégorie, principale ou secondaire.
  roomLinks RoomCategory[]

  @@map("categories")
}

/// Rattachement d'une salle à une catégorie.
///
/// Une salle peut servir plusieurs types d'événement (mariage *et* fiançailles,
/// par exemple). Invariant maintenu par les actions et le seed : la catégorie
/// principale (`Room.categoryId`) figure toujours dans cette table. Les filtres
/// du catalogue et de la recherche s'appuient donc uniquement sur elle, tandis
/// que `Room.categoryId` ne sert qu'à savoir laquelle afficher en premier.
model RoomCategory {
  roomId     String
  categoryId String

  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([roomId, categoryId])
  @@index([categoryId])
  @@map("room_categories")
}

model Room {
  id          String     @id @default(cuid())
  ownerId     String
  categoryId  String
  name        String
  description String     @db.Text
  city        String
  /// Quartier, affiché dans le fil d'Ariane de la fiche salle.
  district    String?
  address     String
  latitude    Float?
  longitude   Float?
  /// Nombre d'invités en dessous duquel la salle ne se loue pas.
  ///
  /// Facultatif : beaucoup de salles n'annoncent qu'une capacité maximale, et
  /// écrire « 1 » pour dire « pas de minimum » reviendrait à afficher une
  /// fourchette que le propriétaire n'a jamais donnée. `null` signifie donc
  /// « aucun minimum » — les filtres du catalogue et le contrôle d'une demande
  /// de réservation le lisent ainsi.
  capacityMin Int?
  capacityMax Int
  basePrice   Decimal    @db.Decimal(10, 2)
  status      RoomStatus @default(PENDING)

  // --- Caractéristiques affichées sur la fiche salle -----------------------
  // Toutes facultatives : une salle publiée avant l'ajout de ces champs reste
  // valide, et la fiche masque simplement les lignes non renseignées.

  /// Superficie en m².
  surfaceM2        Int?
  /// Nombre d'espaces distincts (grande salle, mezzanine, jardin…).
  spacesCount      Int?
  hasParking       Boolean   @default(false)
  hasAccommodation Boolean   @default(false)
  /// Renseigné par l'équipe LIUDOR après vérification : sert de badge « vérifié ».
  verifiedAt       DateTime?
  /// Visite vidéo, mise en avant par une vignette « play » dans la galerie.
  videoUrl         String?

  // --- Informations pratiques ---------------------------------------------

  /// Plage horaire d'utilisation, ex. « 08:00 – 02:00 ».
  openingHours       String?
  /// Règles de sonorisation, ex. « Sonorisation autorisée jusqu'à 2h ».
  musicPolicy        String?
  /// Libellé court de la politique d'annulation, ex. « Flexible ».
  cancellationPolicy String?
  /// Conditions complètes, affichées dans la modale ouverte depuis la fiche.
  cancellationTerms  String?  @db.Text
  /// Caution demandée à la réservation.
  depositAmount      Decimal? @db.Decimal(10, 2)
  cleaningFee        Decimal? @db.Decimal(10, 2)
  petsAllowed        Boolean  @default(false)
  wheelchairAccess   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User             @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// Catégorie principale : celle affichée sur les cartes et la fiche.
  category       Category         @relation(fields: [categoryId], references: [id])
  /// Toutes les catégories de la salle, principale incluse (voir `RoomCategory`).
  categories     RoomCategory[]
  photos         Photo[]
  availabilities Availability[]
  bookings       Booking[]
  reviews        Review[]
  equipments     RoomEquipment[]
  services       RoomService[]
  /// Grille tarifaire détaillée : formules et créneaux, au-delà du prix d'appel.
  rates          RoomRate[]
  favorites      Favorite[]
  /// Décisions de validation et de rejet prises par l'équipe LIUDOR.
  moderations    RoomModeration[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([city])
  @@index([status])
  @@map("rooms")
}

enum ModerationAction {
  APPROVED
  REJECTED
}

/// Décision de modération prise par un administrateur sur une salle.
///
/// Journal et non simple champ sur `Room` : une salle peut être refusée, puis
/// corrigée, puis validée. L'administration doit pouvoir relire cet
/// enchaînement — le statut courant de la salle ne raconte que la fin.
/// Le motif est obligatoire pour un rejet ; c'est ce que lit le propriétaire.
model RoomModeration {
  id        String           @id @default(cuid())
  roomId    String
  /// Auteur de la décision. `null` si le compte administrateur a été supprimé :
  /// la décision, elle, reste au dossier.
  adminId   String?
  action    ModerationAction
  reason    String?          @db.Text
  createdAt DateTime         @default(now())

  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  admin User? @relation("RoomModerator", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([createdAt])
  @@map("room_moderations")
}

model Photo {
  id       String  @id @default(cuid())
  roomId   String
  url      String
  /// Identifiant Cloudinary (`public_id`), requis pour supprimer l'asset.
  /// Null pour une photo qui ne vient pas de Cloudinary (import, seed).
  publicId String?
  position Int     @default(0)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("photos")
}

model Availability {
  id     String             @id @default(cuid())
  roomId String
  date   DateTime           @db.Date
  status AvailabilityStatus @default(AVAILABLE)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@index([date])
  @@map("availabilities")
}

/// Salle enregistrée en favori par un utilisateur.
///
/// Clé primaire composite : un même utilisateur ne peut pas enregistrer deux
/// fois la même salle, et l'ajout comme le retrait se font sans lecture
/// préalable. Aucune restriction de rôle en base — un propriétaire ou un
/// administrateur peut lui aussi mettre une salle de côté.
model Favorite {
  userId    String
  roomId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@index([roomId])
  @@map("favorites")
}

model Equipment {
  id   String @id @default(cuid())
  name String @unique

  rooms RoomEquipment[]

  @@map("equipments")
}

model RoomEquipment {
  roomId      String
  equipmentId String
  /// Précision propre à cette salle (« 120 places », « Fibre 100 Mb/s »).
  ///
  /// Portée par le rattachement et non par `Equipment`, qui est un référentiel
  /// partagé par toutes les salles : le nombre de places de parking d'une salle
  /// n'a aucune raison de s'appliquer aux autres.
  detail      String?

  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([roomId, equipmentId])
  @@map("room_equipments")
}

model Service {
  id    String  @id @default(cuid())
  /// Unique : c'est le nom qui identifie une prestation. Le formulaire salle
  /// n'envoie que des libellés et crée la ligne manquante au premier usage.
  name  String  @unique
  price Decimal @db.Decimal(10, 2)

  rooms    RoomService[]
  /// Demandes de réservation où le client a coché cette prestation.
  bookings BookingService[]

  @@map("services")
}

model RoomService {
  roomId    String
  serviceId String
  /// Tarif pratiqué par **cette** salle pour la prestation.
  ///
  /// Porté par le rattachement et non par `Service`, qui est un référentiel
  /// partagé : le traiteur d'une salle d'Alger n'a aucune raison de fixer le
  /// prix de celui d'Oran. `null` signifie « non fixé » et la fiche retombe
  /// alors sur le tarif indicatif de `Service.price`, lui-même à 0 pour une
  /// prestation ajoutée à la main — ce qui s'affiche « Sur devis ».
  price     Decimal? @db.Decimal(10, 2)

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([roomId, serviceId])
  @@map("room_services")
}

/// Unité d'un tarif : ce que le montant achète.
///
/// `FORFAIT` couvre la location d'un créneau, quel que soit le nombre
/// d'invités ; `COUVERT` est le prix par assiette servie, l'usage courant pour
/// un dîner ; `PERSONNE` sert aux formules sans repas (pause-café, séminaire) ;
/// `HEURE` aux locations courtes.
enum RateUnit {
  FORFAIT
  COUVERT
  PERSONNE
  HEURE
}

/// Ligne de la grille tarifaire d'une salle : « Location soirée (21h – 3h),
/// 270 000 DA ».
///
/// `Room.basePrice` ne dit qu'un prix d'appel — c'est lui qui alimente les
/// cartes, les filtres et le tri du catalogue. Une salle des fêtes se loue en
/// réalité par créneau et par formule, à des tarifs qui n'ont pas de rapport
/// entre eux : le client qui compare deux salles a besoin de cette grille, pas
/// d'un prix unique. D'où une table à part plutôt que des colonnes sur `Room` —
/// le nombre de formules varie d'une salle à l'autre, et beaucoup n'en ont
/// aucune.
///
/// Rien n'est partagé avec les autres salles, contrairement à `Service` : un
/// libellé et un tarif ne valent que pour la salle qui les a saisis. Le
/// formulaire propose bien des formules types (`lib/rooms/rates.ts`), mais elles
/// ne servent qu'à préremplir la saisie.
model RoomRate {
  id       String   @id @default(cuid())
  roomId   String
  /// Intitulé de la formule, ex. « Dîner et demi-soirée ».
  label    String
  /// Créneau ou précision affichée sous le libellé, ex. « 17h – minuit » ou
  /// « pour les 2 salles ». Null quand la formule se suffit à elle-même.
  detail   String?
  price    Decimal  @db.Decimal(10, 2)
  unit     RateUnit @default(FORFAIT)
  /// Ordre d'affichage, tel que le propriétaire a rangé ses formules.
  position Int      @default(0)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("room_rates")
}

model Booking {
  id           String        @id @default(cuid())
  clientId     String
  roomId       String
  eventType    String
  eventDate    DateTime      @db.Date
  guestsCount  Int
  contactPhone String
  contactEmail String
  status       BookingStatus @default(EN_ATTENTE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  client   User             @relation("BookingClient", fields: [clientId], references: [id], onDelete: Cascade)
  room     Room             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  payment  Payment?
  /// Prestations que le client a cochées en déposant sa demande.
  services BookingService[]

  @@index([clientId])
  @@index([roomId])
  @@index([status])
  @@map("bookings")
}

/// Argent d'une réservation, suivi en deux temps.
///
/// Tout se règle en espèces : le client remet la somme à LIUDOR, qui la reverse
/// ensuite au propriétaire. Les deux mouvements vivent sur la même ligne parce
/// qu'ils portent sur la même réservation — c'est ce qui permet de lire d'un
/// coup d'œil ce qui est encaissé mais pas encore reversé, la seule situation
/// où la plateforme détient de l'argent qui ne lui appartient pas.
///
/// `status` et `paidAt` décrivent la première étape (client → LIUDOR), les
/// champs `payout*` la seconde (LIUDOR → propriétaire). Un reversement sans
/// encaissement est refusé par l'action serveur : la plateforme ne reverse pas
/// ce qu'elle n'a pas reçu.
/// Prestation demandée par le client au moment de sa demande de réservation.
///
/// Une demande n'est pas un devis : le client dit ce qui l'intéresse — traiteur,
/// photographe — et l'équipe LIUDOR chiffre au téléphone. D'où un simple
/// rattachement, sans montant figé : le tarif qui fait foi reste celui de la
/// salle (`RoomService.price`), qui peut évoluer entre la demande et l'appel.
model BookingService {
  bookingId String
  serviceId String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([bookingId, serviceId])
  @@index([serviceId])
  @@map("booking_services")
}

model Payment {
  id         String        @id @default(cuid())
  bookingId  String        @unique
  amount     Decimal       @db.Decimal(10, 2)
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  recordedBy String?
  createdAt  DateTime      @default(now())

  /// Somme remise au propriétaire. Distincte de `amount` : elle peut différer
  /// du montant encaissé (arrangement, avoir), et la comparer au reçu est la
  /// première chose que fait un contrôle de caisse.
  payoutAmount     Decimal?  @db.Decimal(10, 2)
  /// Date du reversement au propriétaire, `null` tant que rien n'est reversé.
  payoutAt         DateTime?
  /// Administrateur ayant remis les espèces au propriétaire.
  payoutRecordedBy String?

  booking              Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recordedByUser       User?   @relation("PaymentRecorder", fields: [recordedBy], references: [id])
  payoutRecordedByUser User?   @relation("PaymentPayoutRecorder", fields: [payoutRecordedBy], references: [id])

  @@index([status])
  @@index([payoutAt])
  @@map("payments")
}

model Review {
  id          String    @id @default(cuid())
  roomId      String
  clientId    String
  rating      Int
  comment     String    @db.Text
  /// Photo jointe à l'avis, affichée en vignette sous le commentaire.
  photoUrl    String?
  /// Date de mise en ligne de l'avis, `null` tant qu'il attend la modération.
  /// Les lectures publiques (fiche salle, notes moyennes) ne retiennent que
  /// les avis publiés ; le réglage `reviewAutoPublish` décide si un nouvel
  /// avis est publié d'emblée ou mis en attente.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  client User @relation("ReviewClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([roomId, clientId])
  @@index([clientId])
  @@map("reviews")
}

model BlogPost {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  content            String    @db.Text
  coverImageUrl      String?
  /// Identifiant Cloudinary de la couverture, requis pour supprimer l'ancien
  /// fichier lors d'un remplacement. Null pour une image importée autrement.
  coverImagePublicId String?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("blog_posts")
}

/// Témoignage mis en avant sur la page d'accueil.
///
/// Distinct de `Review` : un avis est laissé par un client sur une salle
/// précise et reste rattaché à son séjour, alors qu'un témoignage est choisi et
/// saisi par l'équipe pour la vitrine — il peut citer quelqu'un qui n'a pas de
/// compte, ou résumer plusieurs échanges. Les deux ne se remplacent pas, d'où
/// deux tables.
///
/// Comme un article, un témoignage reste invisible tant que `publishedAt` est
/// nul : l'équipe le prépare, le relit, puis le met en ligne.
model Testimonial {
  id          String    @id @default(cuid())
  /// Nom affiché sous la citation. Les initiales de l'avatar en sont dérivées.
  authorName  String
  /// Contexte affiché sous le nom, ex. « Mariage · Alger ».
  role        String
  /// Note sur 5, affichée en étoiles.
  rating      Int
  quote       String    @db.Text
  /// Ordre d'affichage croissant sur l'accueil ; les ex æquo sont départagés
  /// par la date de publication, la plus récente en premier.
  position    Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt, position])
  @@map("testimonials")
}

/// Message envoyé depuis le formulaire /contact. L'équipe LIUDOR le lit dans
/// l'administration (/admin/messages) ; un exemplaire part aussi par email.
model ContactMessage {
  id        String    @id @default(cuid())
  fullName  String
  email     String
  subject   String
  /// Contenu du message, en clair.
  message   String    @db.Text
  /// Renseigné quand un administrateur marque le message comme traité.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt])
  @@index([createdAt])
  @@map("contact_messages")
}

/// Réglages éditables de la plateforme.
///
/// Table à ligne unique (`id = "platform"`) plutôt qu'un magasin clé/valeur :
/// chaque réglage garde son type en base, et une lecture suffit à tout charger.
model PlatformSettings {
  id                  String   @id @default("platform")
  siteName            String   @default("LIUDOR")
  tagline             String   @default("Lieux d'Or")
  contactEmail        String   @default("contact@liudor.dz")
  contactPhone        String?
  address             String?
  /// Délai minimum, en jours, entre une demande et la date de l'événement.
  bookingLeadTimeDays Int      @default(2)
  /// Un nouvel avis est-il publié sans passer par la modération ?
  reviewAutoPublish   Boolean  @default(true)
  /// Coupe les nouvelles demandes de réservation le temps d'une intervention.
  maintenanceMode     Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  @@map("platform_settings")
}

enum AuditAction {
  SIGN_IN
  ROOM_APPROVED
  ROOM_REJECTED
  USER_SUSPENDED
  USER_REACTIVATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_RECORDED
  PAYMENT_PAID_OUT
  REVIEW_PUBLISHED
  REVIEW_DELETED
  POST_PUBLISHED
  POST_UNPUBLISHED
  POST_SAVED
  TESTIMONIAL_SAVED
  TESTIMONIAL_PUBLISHED
  TESTIMONIAL_UNPUBLISHED
  CATALOG_UPDATED
  SETTINGS_UPDATED
  PASSWORD_CHANGED
}

/// Journal des actions sensibles de l'administration.
///
/// Écrit par les actions serveur elles-mêmes, jamais par l'interface : une
/// entrée ne peut donc pas manquer parce qu'un écran a oublié de la poser.
/// `target` et `detail` sont figés au moment de l'action — le journal doit
/// rester lisible même si la salle ou le compte concerné a disparu depuis.
model AuditLog {
  id        String      @id @default(cuid())
  /// Auteur de l'action. `null` si le compte a été supprimé depuis.
  userId    String?
  action    AuditAction
  /// Objet concerné, tel qu'il s'appelait au moment de l'action.
  target    String?
  /// Précision libre : montant encaissé, motif, ancienne et nouvelle valeur.
  detail    String?
  createdAt DateTime    @default(now())

  user User? @relation("AuditAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}
